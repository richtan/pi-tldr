{
  "name": "pi-tldr",
  "version": "0.5.0",
  "description": "A pi coding-agent extension that shows live TLDRs above the input bar.",
  "type": "module",
  "license": "MIT",
  "author": "Richie Tan",
  "repository": {
    "type": "git",
    "url": "https://github.com/richtan/pi-tldr"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "tldr",
    "llm",
    "tui"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build:test": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('.tmp-test', {recursive: true, force: true})\" && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test .tmp-test/test/*.js",
    "format": "prettier --write README.md package.json \"tsconfig*.json\" \".github/workflows/*.yml\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check README.md package.json \"tsconfig*.json\" \".github/workflows/*.yml\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "pack:dry-run": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@types/node": "^20.19.39",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
