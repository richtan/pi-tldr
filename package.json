{
  "name": "pi-tldr",
  "version": "0.1.0",
  "description": "A pi coding-agent extension that shows live TLDR summaries above the input bar.",
  "type": "module",
  "license": "MIT",
  "author": "Richie Tan",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "tldr",
    "llm",
    "tui"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.72.0",
    "@mariozechner/pi-coding-agent": "^0.72.0",
    "@mariozechner/pi-tui": "^0.72.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
